
{
  "name": "ourspace-web",

  "main": "src/worker.js",

  "compatibility_date": "2026-10-05",

  "assets": {
    "directory": "./public",
    "binding": "ASSETS"
  },

  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "ourspace-web-db",
      "database_id": "3b963882-6018-4765-9cb5-6f8834ebf407",
      "migrations_dir": "migrations",
      "remote": true
    },
    {
      "binding": "ERP_DB",
      "database_name": "ourspace-erp-db",
      "database_id": "cade1a10-97e1-49df-9ce6-bf7b670d1611",
      "remote": true
    },
    {
     "binding": "BRACKET_DB",
     "database_name": "ourspace-bracket-db",
     "database_id": "2bc8ddfb-8ed8-4b78-adb4-273b2bcf642e"
    }
  ]
}
