
{
  "name": "ourspace-web",

  "main": "src/worker.js",

  "compatibility_date": "2026-10-05",

  "assets": {
    "directory": "./public",
    "binding": "ASSETS"
  },

  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "ourspace-web-db",
